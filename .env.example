# Lets the feedback form file bug reports as GitHub issues.
# Use a fine-grained token with "Issues: read and write" on the repositories below.
GITHUB_TOKEN=

# Where bug reports are filed, as owner/name. These are the defaults.
# GITHUB_REPO_TOWN_HALL=Collert/town_hall
# GITHUB_REPO_PAVILION=Collert/Pavilion
# GITHUB_REPO_WEBSITE=Hamlet-apps/website

# Behind a reverse proxy, tells the server which header carries the visitor's
# address, so one busy visitor can't use up everyone's report allowance.
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
